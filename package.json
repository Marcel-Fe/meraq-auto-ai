{
  "name": "meraq-auto-ai",
  "private": true,
  "version": "1.0.0",
  "description": "MERAQ AUTO AI – Dein intelligenter Begleiter für alle Fahrzeuge",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --port 4173",
    "verify": "node scripts/verify.mjs",
    "analyze": "node scripts/analyze-bundle.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:vehicles": "node scripts/test-vehicles.mjs",
    "test:ai": "node scripts/test-ai-providers.mjs",
    "test:workshops": "node scripts/test-workshops.mjs",
    "test:image": "node --experimental-strip-types scripts/test-vehicle-image.mjs",
    "test:part": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-part-cost.mjs",
    "test:partsearch": "node scripts/test-part-search.mjs",
    "test:3d": "node scripts/shot-3d.mjs",
    "test:calc": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-calc.mjs",
    "test:ics": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-ics.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
